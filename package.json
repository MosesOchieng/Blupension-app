{
  "name": "blupension-app",
  "version": "1.0.0",
  "description": "Blupension Investment Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:server": "nodemon server.js",
    "dev:client": "vite",
    "dev": "vite",
    "build": "cd contracts && npx hardhat compile && cd .. && vite build && node scripts/copy-assets.js",
    "preview": "vite preview",
    "test": "hardhat test",
    "test:api": "mocha test/**/*.test.js --timeout 10000",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "migrate": "node migrations/run.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/styles.css --watch",
    "test:react": "jest src/components/__tests__"
  },
  "keywords": [
    "investment",
    "pension",
    "blockchain",
    "crypto"
  ],
  "author": "Blupension",
  "license": "ISC",
